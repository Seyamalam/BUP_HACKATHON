# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Vercel AI Gateway API key — first-priority provider for note interpretation (secret).
# @type=string(minLength=1)
AI_GATEWAY_API_KEY=

# Comma-separated Vercel AI Gateway model chain, tried in order.
# @public @optional @type=string
AI_GATEWAY_MODELS=

# OpenRouter API key used for operator-note interpretation (secret).
# @type=string(minLength=1)
OPENROUTER_API_KEY=

# Comma-separated OpenRouter model chain, tried in order (free tiers by default).
# @public @optional @type=string
OPENROUTER_MODELS=
