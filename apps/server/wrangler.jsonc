{
  "$schema": "../../node_modules/wrangler/wrangler-dist/config-schema.json",
  "name": "gridwise-llm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "minify": true,
  "vars": {
    "GEMINI_MODELS": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite",
    "OPENROUTER_MODELS": "inclusionai/ling-3.0-flash-sante:free,openrouter/free",
  },
}
